# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── ADA cluster (scripts/batch_orchestrate.py) ────────────────────────────────
ADA_HOST=ada.iiit.ac.in
ADA_USER=your_ada_username
# Leave ADA_PASS empty to log in with your SSH key / ssh-agent instead
ADA_PASS=
GPU_NODE=gnode047

# ── LLaMA 3.1 8B weights (stages 1-3) ─────────────────────────────────────────
LLAMA_MODEL_PATH=/path/to/models/llama-8b

# ── Sarvam AI (stage 4 generation) ────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_key

# ── MongoDB Atlas (Express server) ────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ncert_wiki
